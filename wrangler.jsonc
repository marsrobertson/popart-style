// Cloudflare Worker: serves the page from this folder and runs the order server in worker/index.js.
// Setup steps are in README.md, "Selling with Cloudflare and Stripe".
{
  "name": "popart-mixer",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The shop's address. moneyfromthefuture.com's DNS is on Cloudflare, so deploy creates this subdomain itself.
  "routes": [{ "pattern": "popart.moneyfromthefuture.com", "custom_domain": true }],
  "assets": { "directory": ".", "binding": "ASSETS" },
  "kv_namespaces": [
    // Your KV namespace (from: npx wrangler kv namespace create ORDERS). Not a secret: useless without your Cloudflare login.
    { "binding": "ORDERS", "id": "71e37493449e4e6998aa16a74e2bd2ee" }
  ],
  "vars": {
    // Where buyers return after paying. Leave empty to use this Worker's own address.
    "SITE_URL": "https://popart.moneyfromthefuture.com"
  },
  "observability": { "enabled": true }
}
